// Cloudflare Worker settings for changeherefor.com
// The whole repo is served as static files. "name" must match the Worker's name in Cloudflare.
{
  "name": "changeherefor",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
